{
  "name": "codegraff-gui",
  "private": true,
  "version": "0.0.254",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.10",
  "type": "module",
  "scripts": {
    "dev": "bun run build:deps && vite",
    "gen:desktop-contracts": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --example generate_desktop_contracts",
    "build:deps": "bun run --filter '@codegraff/diffs' build",
    "build": "bun run build:deps && bun run gen:desktop-contracts && tsc -b && vite build",
    "lint": "bun run build:deps && bun run gen:desktop-contracts && eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@codegraff/diffs": "workspace:*",
    "@fontsource-variable/geist": "^5.2.8",
    "@legendapp/list": "^3.0.0-beta.44",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "@wterm/dom": "^0.1.9",
    "@zane-chen/agents-are-thinking": "^0.1.6",
    "border-beam": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockview-react": "^5.2.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.8.0",
    "mermaid": "^11.15.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.10.0",
    "seti-icons": "^0.0.4",
    "shadcn": "^4.3.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.10",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@happy-dom/global-registrator": "^20.13.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.10.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-types": "^1.3.13",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "rollup": "^4.62.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
