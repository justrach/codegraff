diff --git a/apps/native/lib/composer-keyboard.ts b/apps/native/lib/composer-keyboard.ts
new file mode 100644
--- /dev/null
+++ b/apps/native/lib/composer-keyboard.ts
@@ -0,0 +1,10 @@
+// Keyboard activation follows the visible highlight. Hover and arrow keys set
+// `engaged`; until then Enter submits and Tab keeps normal focus traversal.
+export function shouldPickComposerRow(
+  key: string,
+  shiftKey: boolean,
+  engaged: boolean,
+): boolean {
+  if (shiftKey || !engaged) return false;
+  return key === "Enter" || key === "Tab";
+}
diff --git a/apps/native/lib/composer-keyboard.test.ts b/apps/native/lib/composer-keyboard.test.ts
new file mode 100644
--- /dev/null
+++ b/apps/native/lib/composer-keyboard.test.ts
@@ -0,0 +1,32 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { shouldPickComposerRow } from "./composer-keyboard.ts";
+
+test("picks an engaged row on Enter or Tab without Shift", () => {
+  assert.equal(shouldPickComposerRow("Enter", false, true), true);
+  assert.equal(shouldPickComposerRow("Tab", false, true), true);
+});
+
+test("does not pick when the row is not engaged", () => {
+  assert.equal(shouldPickComposerRow("Enter", false, false), false);
+  assert.equal(shouldPickComposerRow("Tab", false, false), false);
+});
+
+test("does not pick on Shift+Enter or Shift+Tab", () => {
+  assert.equal(shouldPickComposerRow("Enter", true, true), false);
+  assert.equal(shouldPickComposerRow("Tab", true, true), false);
+  assert.equal(shouldPickComposerRow("Enter", true, false), false);
+});
+
+test("arrow keys are not activation keys", () => {
+  assert.equal(shouldPickComposerRow("ArrowDown", false, true), false);
+  assert.equal(shouldPickComposerRow("ArrowUp", false, true), false);
+  assert.equal(shouldPickComposerRow("ArrowDown", true, true), false);
+  assert.equal(shouldPickComposerRow("ArrowUp", false, false), false);
+});
+
+test("other keys do not pick a row", () => {
+  assert.equal(shouldPickComposerRow("Escape", false, true), false);
+  assert.equal(shouldPickComposerRow(" ", false, true), false);
+  assert.equal(shouldPickComposerRow("a", false, true), false);
+});
