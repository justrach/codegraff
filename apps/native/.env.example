# Optional. The Next.js proxy talks to graff serve on this URL.
# Start the bridge from the repo root:  zig-out/bin/graff serve --port 8787
GRAFF_SERVE_URL=http://127.0.0.1:8787

# Optional Bearer token (HARNESS_SERVE_TOKEN / graff serve --token).
# Required by graff on non-loopback binds; also the switch that opens CORS
# on the bridge itself. The UI always goes through /api/graff, so the
# browser never needs this.
HARNESS_SERVE_TOKEN=

# Skip bash/tool permission prompts on the child (graff --yolo).
GRAFF_YOLO=1

# Default model or provider id for new sessions (e.g. gpt-5.5, claude-opus-4-8, codex).
NEXT_PUBLIC_GRAFF_MODEL=

# Workspace the child process should run in. Defaults to the repo root.
GRAFF_CWD=
