# Optional path to the graff binary. Defaults to ../../zig-out/bin/graff
# when this app is started from apps/native.
GRAFF_BIN=

# Workspace the ACP child should run in. Defaults to the repo root.
GRAFF_CWD=
GRAFF_ACP_CWD=

# Skip bash/tool permission prompts on the child (graff acp --yolo).
# Default is on: ACP has no session/request_permission UI yet.
# GRAFF_YOLO=0

# Default model or provider id for new sessions (e.g. gpt-5.5, claude-opus-4-8, grok-4.6).
NEXT_PUBLIC_GRAFF_MODEL=
