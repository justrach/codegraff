<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- For the bundled JS runtime only. The hardened runtime forbids
       writable-executable memory, which is exactly what a JavaScript JIT
       needs: without this the runtime is killed the moment it compiles
       anything, and the app opens onto nothing. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The interface loads whatever its dependencies bring with them, which
       is not signed by this team. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
