{
  "name": "@codegraff/sdk",
  "version": "0.3.1",
  "description": "TypeScript / Node SDK for the codegraff agent — drives `graff --json` over stdio. Types auto-generated from `graff --schema`.",
  "type": "module",
  "main": "harness.ts",
  "types": "harness.ts",
  "exports": {
    ".": {
      "types": "./harness.ts",
      "import": "./harness.ts",
      "default": "./harness.ts"
    },
    "./remote": {
      "types": "./remote.ts",
      "import": "./remote.ts",
      "default": "./remote.ts"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justrach/codegraff.git",
    "directory": "sdk/ts"
  },
  "homepage": "https://codegraff.com",
  "keywords": ["codegraff", "graff", "agent", "llm", "harness", "sdk"],
  "files": ["harness.ts", "remote.ts", "README.md"],
  "engines": { "node": ">=18" },
  "license": "BSD-3-Clause"
}
