{
  "name": "@codegraff/sdk",
  "version": "0.3.1",
  "description": "TypeScript / Node SDK for the codegraff agent — drives `graff --json` over stdio. Types auto-generated from `graff --schema`.",
  "type": "module",
  "main": "harness.ts",
  "types": "harness.ts",
  "exports": {
    ".": {
      "types": "./harness.ts",
      "import": "./harness.ts",
      "default": "./harness.ts"
    },
    "./remote": {
      "types": "./remote.ts",
      "import": "./remote.ts",
      "default": "./remote.ts"
    },
    "./orchestrate": {
      "types": "./orchestrate.ts",
      "import": "./orchestrate.ts",
      "default": "./orchestrate.ts"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justrach/codegraff.git",
    "directory": "sdk/ts"
  },
  "homepage": "https://codegraff.com",
  "keywords": ["codegraff", "graff", "agent", "llm", "harness", "sdk"],
  "files": ["harness.ts", "remote.ts", "orchestrate.ts", "README.md"],
  "engines": { "node": ">=18" },
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "bun-types": "^1.3.11",
    "typescript": "~5.9.3"
  }
}
